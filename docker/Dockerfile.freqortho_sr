# FreqOrtho-SR 推理环境（结构恢复：one-step + upscale 4，四分之一分辨率）
#
# 钉版来源：work/04_environment/environment-freqortho.yaml
#   （ENVIRONMENT.md 标注的"重建环境"：python 3.10 / torch 2.9.1（PyPI 轮子自带 cu12.8 运行库）
#    / transformers 4.37.2 / diffusers 0.25.0 / xformers 0.0.33.post2 / pyiqa 0.1.14.1）
# 注意：work/04_environment/requirements-freqortho.txt 为旧版钉版（torch 2.0.1），与 yaml 不一致，
#       docker/requirements-freqortho.txt 由 yaml 的 pip 段生成，以 ENVIRONMENT.md 标注为准。
#
# ⚠️ 归档机无 Docker 与 NVIDIA GPU：本镜像未实测构建与推理；
#    运行需宿主机 NVIDIA 驱动 ≥ 525.60（CUDA 12.x 兼容）+ NVIDIA Container Toolkit。
FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY docker/requirements-freqortho.txt /tmp/req-freqortho.txt
RUN pip install --no-cache-dir -r /tmp/req-freqortho.txt

# 源码 + 微调权重（freqortho_sr.pkl 57.7MB 随镜像内置）
COPY work/01_freqortho_sr /opt/FreqOrtho-SR
# 推理管线脚本与配置（scene_4k.json、compare/select/build 等）
COPY work/03_pipeline /opt/pipeline
# 环境说明与依赖清单原件
COPY work/04_environment /opt/env-notes

ENV PYTHONUNBUFFERED=1
CMD ["bash"]
